{
  "name": "playwright-smart-vision-monorepo",
  "private": true,
  "packageManager": "pnpm@10.33.2",
  "scripts": {
    "build": "pnpm --filter @rickcedwhat/playwright-smart-vision build",
    "build:all": "pnpm -r build",
    "typecheck": "pnpm -r --if-present typecheck",
    "test:unit": "pnpm -r --if-present test:unit",
    "test:e2e": "pnpm -r --if-present test:e2e",
    "dev": "node packages/tools/template-manager-server.mjs",
    "tm": "pnpm build && pnpm --filter @playwright-smart-vision/demo-tests tm",
    "dev:fixtures": "node packages/core/scripts/serve-fixtures.mjs",
    "demo": "pnpm --filter @playwright-smart-vision/demo-app serve",
    "demo:test": "pnpm --filter @playwright-smart-vision/demo-tests test:e2e",
    "demo:report": "pnpm --filter @playwright-smart-vision/demo-tests exec playwright show-report",
    "demo:capture": "pnpm --filter @playwright-smart-vision/demo-tests capture",
    "capture": "pnpm --filter @rickcedwhat/playwright-smart-vision test:e2e --grep=CAPTURE_ONLY_NO_TESTS --pass-with-no-tests"
  }
}
