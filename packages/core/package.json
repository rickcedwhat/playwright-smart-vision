{
  "name": "@rickcedwhat/playwright-smart-vision",
  "version": "0.1.0",
  "description": "Computer-vision and OCR-based element assertions for Playwright — local, fast, no GPT Vision required",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./utils/ocr": {
      "import": "./dist/utils/ocr.js",
      "types": "./dist/utils/ocr.d.ts"
    },
    "./utils/vision": {
      "import": "./dist/utils/vision.js",
      "types": "./dist/utils/vision.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "playwright",
    "ocr",
    "computer-vision",
    "visual-testing",
    "tesseract",
    "opencv"
  ],
  "author": "rickcedwhat",
  "license": "MIT",
  "peerDependencies": {
    "@playwright/test": ">=1.50.0"
  },
  "dependencies": {
    "opencv.js": "^1.2.1",
    "pixelmatch": "^7.2.0",
    "pngjs": "^7.0.0",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.2.0",
    "@types/pngjs": "^6.0.5",
    "typescript": "^7.0.2"
  }
}
